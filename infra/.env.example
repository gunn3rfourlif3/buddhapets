# Copy to infra/.env on the server and generate real values:
#   MARIADB_PASSWORD=$(openssl rand -base64 24)
# Never commit the real file — it is gitignored, and it exists only on the VPS.

DOMAIN=buddhapets.co.za
CMS_DOMAIN=cms.buddhapets.co.za
ACME_EMAIL=you@example.com

MARIADB_PASSWORD=generate_me
MARIADB_ROOT_PASSWORD=generate_me
POSTGRES_PASSWORD=generate_me

# Filled in after step 6 of the runbook (WooCommerce → Settings → Advanced → REST API).
# Only needed when you deploy the storefront service.
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
